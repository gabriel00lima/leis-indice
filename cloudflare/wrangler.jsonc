// Configuração do Worker "leis-do-brasil". Ver cloudflare/README.md.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "leis-do-brasil",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",

  // Páginas, JS, CSS e data/ (gerados por separar.sh em _cf/assets).
  // Arquivo que existe aqui é entregue sem rodar o Worker (grátis e ilimitado).
  "assets": {
    "directory": "../_cf/assets",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },

  // lei/, api/ e pagefind/ (centenas de milhares de arquivos) ficam no R2.
  "r2_buckets": [
    { "binding": "SITE", "bucket_name": "leis-do-brasil" }
  ],

  "observability": { "enabled": true }
}
